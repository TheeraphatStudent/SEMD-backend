#!/usr/bin/env python3
from __future__ import annotations

import os
import re
import subprocess
import sys
from pathlib import Path


MODULE_ROOTS = (
    "config",
    "control",
    "core",
    "database",
    "guard",
    "libs",
    "models",
    "routers",
    "services",
    "tests",
    "workers",
)
IMPORT_RE = re.compile(r"^(?:from\s+([\w\.]+)\s+import|import\s+([\w\.]+))")
MODULE_DESCRIPTIONS = {
    "application.py": "FastAPI app factory and router registration.",
    "config": "Settings and configuration loading.",
    "control": "Business logic layer between routers and services.",
    "core": "Cross-cutting app behavior like middleware, errors, health, logging.",
    "database": "Database models and persistence wiring.",
    "guard": "Auth and request guard dependencies.",
    "libs": "Shared enums, helpers, and common types.",
    "main.py": "Runtime entrypoint.",
    "models": "Pydantic request and response schemas.",
    "routers": "HTTP route definitions and API grouping.",
    "services": "Data access and external integration logic.",
    "tests": "Unit test coverage and behavior checks.",
    "workers": "Background workers and async processing entrypoints.",
}


def repo_root() -> Path:
    return Path(__file__).resolve().parent


def build_graph() -> dict[str, set[str]]:
    root = repo_root()
    edges: dict[str, set[str]] = {}
    for path in root.rglob("*.py"):
        if ".venv" in path.parts or "__pycache__" in path.parts:
            continue
        rel = path.relative_to(root)
        src = rel.parts[0]
        if src not in MODULE_ROOTS and rel.name not in {"application.py", "main.py"}:
            continue

        label = rel.as_posix() if src not in MODULE_ROOTS else src
        current = edges.setdefault(label, set())
        try:
            for raw_line in path.read_text(encoding="utf-8").splitlines():
                match = IMPORT_RE.match(raw_line.strip())
                if not match:
                    continue
                module = (match.group(1) or match.group(2) or "").split(",", 1)[0].strip()
                top = module.split(".", 1)[0]
                if top in MODULE_ROOTS and top != src:
                    current.add(top)
        except OSError:
            continue
    return edges


def build_graph_lines() -> list[str]:
    edges = build_graph()
    lines: list[str] = []
    for src in sorted(edges):
        deps = ", ".join(sorted(edges[src])) or "(none)"
        lines.append(f"{src} -> {deps}")
    return lines


def build_wiki_lines() -> list[str]:
    edges = build_graph()
    reverse: dict[str, set[str]] = {name: set() for name in edges}
    for src, deps in edges.items():
        for dep in deps:
            reverse.setdefault(dep, set()).add(src)

    lines: list[str] = ["# Graphify Wiki", ""]
    for name in sorted(edges):
        deps = ", ".join(sorted(edges[name])) or "(none)"
        used_by = ", ".join(sorted(reverse.get(name, set()))) or "(none)"
        desc = MODULE_DESCRIPTIONS.get(name, "No description.")
        lines.extend(
            [
                f"## {name}",
                f"- role: {desc}",
                f"- depends on: {deps}",
                f"- used by: {used_by}",
                "",
            ]
        )
    return lines


def write_output(lines: list[str], write_path: str | None = None) -> int:
    output = "\n".join(lines) + ("\n" if lines else "")
    if write_path:
        target = Path(write_path)
        if not target.is_absolute():
            target = repo_root() / target
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_text(output, encoding="utf-8")
    sys.stdout.write(output)
    return 0


def cmd_graph(write_path: str | None = None) -> int:
    return write_output(build_graph_lines(), write_path)


def cmd_wiki(write_path: str | None = None) -> int:
    return write_output(build_wiki_lines(), write_path)


def help_text() -> str:
    return """graphify commands:
  graphify .
  graphify . --write .graphify/graph.txt
  graphify . --wiki
  graphify hook install
  graphify help
"""


def install_hook() -> int:
    root = repo_root()
    env = os.environ.copy()
    env["GIT_CONFIG_NOSYSTEM"] = "1"
    proc = subprocess.run(
        ["git", "rev-parse", "--git-dir"],
        cwd=root,
        env=env,
        capture_output=True,
        text=True,
        check=False,
    )
    if proc.returncode != 0:
        sys.stderr.write(proc.stderr or "graphify: cannot find git dir\n")
        return proc.returncode or 1

    git_dir = Path(proc.stdout.strip())
    if not git_dir.is_absolute():
        git_dir = (root / git_dir).resolve()
    hooks_dir = git_dir / "hooks"
    hooks_dir.mkdir(parents=True, exist_ok=True)
    hook_path = hooks_dir / "post-commit"
    snapshot_rel = ".graphify/graph.txt"
    script = f"""#!/usr/bin/env bash
set -euo pipefail
cd {root}
python3 {root / "graphify"} . --write {snapshot_rel} >/dev/null
"""
    hook_path.write_text(script, encoding="utf-8")
    hook_path.chmod(0o755)
    cmd_graph(snapshot_rel)
    print(f"hook installed: {hook_path}")
    return 0


def main(argv: list[str]) -> int:
    if len(argv) == 1 or argv[1] == "help":
        sys.stdout.write(help_text())
        return 0
    if argv[1] == ".":
        write_path = None
        wiki = False
        if len(argv) == 3 and argv[2] == "--wiki":
            wiki = True
        elif len(argv) == 4 and argv[2] == "--write":
            write_path = argv[3]
        elif len(argv) != 2:
            sys.stderr.write(help_text())
            return 2
        return cmd_wiki(write_path) if wiki else cmd_graph(write_path)
    if argv[1:3] == ["hook", "install"]:
        return install_hook()
    sys.stderr.write(help_text())
    return 2


if __name__ == "__main__":
    raise SystemExit(main(sys.argv))
